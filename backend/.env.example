# Backend Environment Variables Example
# Copy this to .env and fill in the actual values

# FastAPI Settings
APP_NAME=Patient Management API
DEBUG=False
API_PREFIX=/api

# Database - These will be fetched from AWS Secrets Manager
# DO NOT put actual values here. The app will load from Secrets Manager
DATABASE_URL=mysql+pymysql://user:password@localhost/patient_db

# JWT - These will be fetched from AWS Secrets Manager
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# AWS Settings
AWS_REGION=us-east-1
S3_BUCKET_NAME=patient-images-bucket
