# Backend Environment Variables
# Copy this file to .env and fill in the values.
#
# NOTE: DATABASE_URL, JWT_SECRET_KEY, and S3_BUCKET_NAME are loaded
# automatically from AWS Secrets Manager at startup.
# You only need AWS_REGION here.

# App settings
APP_NAME=Patient Management API
DEBUG=False
API_PREFIX=/api

# JWT settings (secret comes from Secrets Manager)
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# AWS region — must match where your resources live
AWS_REGION=us-east-1

# ── Local development only ─────────────────────────────────────────────────────
# Uncomment and fill these for local dev (when no Secrets Manager available).
# In production (EC2 with IAM role), leave these commented out.

# DATABASE_URL=mysql+pymysql://patient_app:password@localhost/patient_db
# JWT_SECRET_KEY=local-dev-secret-change-in-production
# S3_BUCKET_NAME=patient-docs-your-account-id
